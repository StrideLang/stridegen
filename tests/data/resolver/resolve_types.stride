###################
# Module resolution forward
module PassThroughForward {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: InputPort.type}
        signal Output { type: InputPort.type}
    ]
    streams: [
        Input >> Output;
    ]
}

signal ForwardModuleIn {}
signal ForwardModuleOut {}
signal ForwardModuleInInt { type: Int}
signal ForwardModuleOutInt { type: Int}
signal ForwardModuleOutResolved {}
signal ForwardModuleInResolved {}
signal ForwardModuleInNotResolved {}

ForwardModuleIn >> PassThroughForward() >> ForwardModuleOut; # nothing should be resolved here
ForwardModuleInInt >> PassThroughForward() >> ForwardModuleOutResolved; # forward resolve
ForwardModuleInNotResolved >> PassThroughForward() >> ForwardModuleOutInt; # reverse resolve, not resolved

###################
# Module resolution reverse
module PassThrough {
    ports: [
        mainInputPort InputPort {
            block: Input
        }
        mainOutputPort OutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: OutputPort.type}
        signal Output { type: OutputPort.type}
    ]
    streams: [
        Input >> Output;
    ]
}

signal ModuleIn {}
signal ModuleOut {}
signal ModuleInInt { type: Int}
signal ModuleOutInt { type: Int}
signal ModuleOutNotResolved {}
signal ModuleInResolved {}

ModuleIn >> PassThrough() >> ModuleOut; # nothing should be resolved here
ModuleInInt >> PassThrough() >> ModuleOutNotResolved; # forward resolve, not resolved
ModuleInResolved >> PassThrough() >> ModuleOutInt; # reverse resolve

######################################
# Module resolution with internal type
module PassThroughWithType {
    ports: [
        mainInputPort {
            block: Input
        }
        mainOutputPort {
            block: Output
        }
    ]
    blocks: [
        signal Input { type: Real }
        signal Output { type: Real }
    ]
    streams: [
        Input >> Output;
    ]
}

signal ModuleInInt { type: Int}
signal ModuleOutInt { type: Int}
signal ModuleWithTypeOutResolved {}
signal ModuleWithTypeInResolved {}

ModuleInInt >> PassThroughWithType() >> ModuleWithTypeOutResolved;
ModuleWithTypeInResolved >> PassThroughWithType() >> ModuleOutInt;

####################
# Forward resolution
signal IntInput { type: Int }
signal Output {}

IntInput >> Output;

# Reverse resolution
signal IntOutput { type: Int}
signal Input {}

Input >> IntOutput;

# Forward resolution recursive
signal IntInput2 { type: Int}
signal OutputA2 {}
signal OutputB2 {}

IntInput2 >> OutputA2 >> OutputB2;

# Reverse resolution recursive
signal IntOutput2 { type: Int}
signal InputA2 {}
signal InputB2 {}

InputA2 >> InputB2 >> IntOutput2;

###########################
# Forward resolution bundle
signal IntInputBundle[2] { type: Int }
signal OutputBundle[2] {}

IntInputBundle >> OutputBundle;

# Reverse resolution bundle
signal IntOutputBundle { type: Int}
signal InputBundle {}

InputBundle >> IntOutputBundle;

# Forward resolution bundle member
signal IntInputBundleMember[2] { type: Int }
signal OutputBundleMember[2] {}

IntInputBundleMember[0] >> OutputBundleMember[0];

# Reverse resolution bundle member
signal IntOutputBundleMember[2] { type: Int}
signal InputBundleMember[2] {}

InputBundleMember[0] >> IntOutputBundleMember[0];