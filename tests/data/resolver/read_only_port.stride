module PassThrough {
    ports: [
        # type is read only on ports. It belongs on the block declaration.
        mainInputPort InputPort { entity: Input type: Int }
        mainOutputPort OutputPort { entity: Output }
    ]
    entities: [
        signal Input { type: Int }
        signal Output { type: Int }
    ]
    streams: [
        Input >> Output;
    ]
}

signal In { type: Int }
signal Out { type: Int }

In >> PassThrough() >> Out;
