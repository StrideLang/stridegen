module PassThrough {
    ports: [
        mainInputPort {
            entity: Input
        }
        mainOutputPort {
            entity: Output
        }
    ]
    entities: [
        signal Input { type: Real }
        signal Output { type: Real }
    ]
    streams: [
        Input >> Output;
    ]
}

signal OuterInput {}
signal OuterOutput {}

## This stream must be in line 23
OuterInput >> PassThrough() >> OuterOutput;