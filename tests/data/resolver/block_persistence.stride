module Test {
    ports: [
        mainInputPort InputPort {
            entity: ModInput
        }
        mainOutputPort OutputPort {
            entity: ModOutput
        }
    ]
    entities: [
        signal ModInput {}
        signal ModOutput {}
        signal Noop {}
        signal WrittenFirst {}
        signal ReadFirst {}
    ]
    streams: [
        Noop >> WrittenFirst;
        WrittenFirst >> Noop;
        ReadFirst >> Noop;
        Noop >> ReadFirst;
    ]
}

signal In {}
signal Out {}

In >> Test() >> Out;