module InvalidSizes {
    ports: [
        mainInputPort InputPort {
            name: 'input'
            entity: Input
        },
        mainOutputPort OutputPort {
            name: 'output'
            entity: Output
        }
    ]
    entities: [
        signal Input[3] {},
        signal Output[2] {}
    ]
    streams: [
        Input >> Output;
    ]
}
